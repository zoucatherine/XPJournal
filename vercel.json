{
  "version": 2,
  "framework": null,
  "buildCommand": "pnpm install --frozen-lockfile && pnpm run build:vercel",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "regions": ["iad1"],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/artifacts/calendar-journal/dist/public/$1"
    },
    {
      "src": "/",
      "dest": "/artifacts/calendar-journal/dist/public/index.html"
    }
  ],
  "outputDirectory": "artifacts/calendar-journal/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/artifacts/calendar-journal/dist/public/index.html"
    }
  ]
}