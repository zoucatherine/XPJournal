{
  "version": 2,
  "framework": null,
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm install --no-frozen-lockfile && pnpm run build:vercel",
  "regions": ["iad1"],
  "env": {
    "NODE_ENV": "production"
  },
  "outputDirectory": "artifacts/calendar-journal/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
